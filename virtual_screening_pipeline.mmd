    E --> F["<b>Stage 3:</b><br>3D conformer rerank"]
    F --> G["Stage-3 audit outputs:<br>full ranked CSV + top-100 CSV + plots"]
    F --> H["Diversified native candidate pool:<br>12k by stage-3 rank<br>4k by hotspot breadth<br>4k by native-supported hotspot score"]
    H --> I["Scaffold-aware native selection:<br>Top 5,000 under Murcko cap"]
    I --> J["Native ligand preparation:<br>microstates, tautomers,<br>multiple 3D conformers"]
    K["Native GLP-1/GLP-1R reference:<br>6X18 peptide-contact pharmacophore"] --> L["Weighted reference-feature table"]
    J --> N["Conformer-aware native scoring<br>against reference features"]
    L --> N
    N --> O["Best conformer per microstate"]
    O --> P["Best state per ligand"]
    P --> Q["Post-score hotspot inference:<br>ligand hotspot map + global hotspot frequencies"]
    P --> R["Native audit table:<br>successful ligand scores and explicit failures"]
    R --> S["Final native ranking:<br>native coverage -> matched features -> RMSD -> pair error<br>then stage-3 screen metrics"]
    S --> T["<b>Primary output:<br>final native top-1000 CSV</b>"]
    P --> U["Always-on diagnostics:<br>correlation, quartiles, rank shift, residuals"]

